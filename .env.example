# Canyon product page URL
# Navigate to the bike on canyon.com, select your exact color AND size, then copy the full URL from your browser.
BIKE_URL=https://www.canyon.com/de-de/rennrad/endurance-rennrad/endurace/allroad/endurace-allroad/4164.html?dwvar_4164_pv_rahmenfarbe=R138_P01&dwvar_4164_pv_rahmengroesse=M

# Telegram bot token — get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Comma-separated list of Telegram user IDs to notify — see README for how to find yours
TELEGRAM_CHAT_IDS=987654321,123456789

# How often to check, in hours (default: 1)
CHECK_INTERVAL_HOURS=1

# --- Optional ---

# Admin Telegram user ID — receives heartbeats and failure alerts (leave unset to disable)
# TELEGRAM_ADMIN_CHAT_ID=987654321

# How often to send a heartbeat to the admin (default: 3)
# HEARTBEAT_INTERVAL_DAYS=3

# Logging level: INFO (default) or DEBUG (verbose)
# LOG_LEVEL=INFO
